# ---------------------------------------------------------------------------
# ZEBRA MOTORS: required environment variables
# ---------------------------------------------------------------------------
# Copy this file to .env for local development (`cp .env.example .env`), then
# fill in real values. .env is gitignored on purpose, a commit can never
# carry secrets, which is exactly why a deployment (Vercel, Netlify, or any
# other host) needs every one of these set separately in that platform's own
# environment variable settings, not just in this file. Signup/sign-in and
# the admin panel will fail with a real, logged error (see
# app/api/customer-auth/*/route.js and app/api/auth/login/route.js) if
# JWT_SECRET is missing, exactly the "Something went wrong" a customer would
# otherwise see with no explanation.
# ---------------------------------------------------------------------------

# Required. Signs both the admin session cookie (lib/auth/session.js) and
# the customer session cookie (lib/auth/customerSession.js). Generate a real
# random value, never reuse this example, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Required to have a working admin login. Read once on every server start
# (lib/db/seedData.js ensureAdminUser()), it creates or updates the admin
# account with these credentials, so changing this and restarting the server
# is also how you rotate the admin password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional. Leave unset for local development, SQLite (prisma/dev.db) is
# used automatically (lib/db/client.js). Set this to a real
# postgres://... or postgresql://... connection string for production, a
# SQLite file does not survive a serverless deployment's cold starts.
DATABASE_URL=

# Optional. Connects Zebra AI Support, the AI Trip Planner parser, and What
# If to a real model (lib/ai/provider.js). Leave both unset and everything
# AI-related keeps running its honest, tested deterministic fallback instead
# of a live model call, see AI_ARCHITECTURE_REPORT.md.
AI_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
